DATABASE_URL=
AI_GATEWAY_API_KEY=

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — email/password works without these)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend) — password resets + "finish your book" reminders
# EMAIL_FROM must be on a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM=Les Flèches <bonjour@lesfleches.com>
# Protects the cron endpoint; generate with: openssl rand -hex 24
CRON_SECRET=

# Payments (Stripe) — carnet checkout
# Use sk_test_/pk_test_ locally; sk_live_/pk_live_ only in production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint. Local: `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints a whsec_…
STRIPE_WEBHOOK_SECRET=
# Set to "1" to turn the real checkout button on (otherwise it captures a
# waitlist email). Client-side flag.
NEXT_PUBLIC_CARNET_CHECKOUT=
# Carnet price in cents (optional; defaults to 3000 = 30,00 €)
CARNET_PRICE_CENTS=3000

# Seller identity for compliant French invoices (REQUIRED before going live).
# A micro-entreprise is an entreprise individuelle: legal name = the person.
SELLER_LEGAL_NAME=
SELLER_SIRET=
# Comma-separated, e.g. "12 rue de X, 75001 Paris, France"
SELLER_ADDRESS=
SELLER_EMAIL=bonjour@lesfleches.com
# Franchise en base de TVA → no VAT charged. Override only if VAT-registered.
SELLER_VAT_MENTION=TVA non applicable, art. 293 B du CGI

# Print-on-demand (Lulu) — book fulfillment
# "production" hits the live API and really prints; anything else = sandbox.
LULU_ENV=
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
SANITY_API_READ_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
